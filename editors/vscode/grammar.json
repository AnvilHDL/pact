{
	"name": "Pact",
	"scopeName": "source.anvil",
	"fileTypes": [
		"anvil",
		"anvilh"
	],
	"foldingStartMarker": "\\{\\s*$",
	"foldingStopMarker": "^\\s*\\}",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#interface"
		},
		{
			"include": "#pool"
		},
		{
			"include": "#channel-class"
		},
		{
			"include": "#struct"
		},
		{
			"include": "#enum"
		},
		{
			"include": "#proc-header"
		},
		{
			"include": "#func-header"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#expressions"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.block.anvil",
					"begin": "/\\*",
					"end": "\\*/",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.comment.anvil"
						}
					},
					"endCaptures": {
						"1": {
							"name": "punctuation.definition.comment.anvil"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						}
					]
				},
				{
					"match": "(//).*$",
					"name": "comment.line.double-slash.anvil",
					"captures": {
						"1": {
							"name": "punctuation.definition.comment.anvil"
						}
					}
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.anvil",
					"begin": "\"",
					"end": "\"",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.string.begin.anvil"
						}
					},
					"endCaptures": {
						"1": {
							"name": "punctuation.definition.string.end.anvil"
						}
					},
					"patterns": [
						{
							"match": "\\\\.",
							"name": "constant.character.escape.anvil"
						},
						{
							"match": "%[-0-9]*[dxXbouscf%]",
							"name": "constant.other.placeholder.anvil"
						}
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"match": "\\b([0-9]+)(')([dbh])([0-9a-fA-F_]+)\\b",
					"name": "constant.numeric.sized.anvil",
					"captures": {
						"1": {
							"name": "constant.numeric.width.anvil"
						},
						"2": {
							"name": "punctuation.separator.anvil"
						},
						"3": {
							"name": "storage.type.numeric.base.anvil"
						},
						"4": {
							"name": "constant.numeric.value.anvil"
						}
					}
				},
				{
					"match": "\\b[0-9]+\\b",
					"name": "constant.numeric.decimal.anvil"
				}
			]
		},
		"delay": {
			"match": "(#)([0-9]+)\\b",
			"captures": {
				"1": {
					"name": "keyword.operator.delay.anvil"
				},
				"2": {
					"name": "constant.numeric.cycles.anvil"
				}
			}
		},
		"primitive-types": {
			"match": "\\b(logic|int|void)\\b",
			"name": "support.type.primitive.anvil"
		},
		"types": {
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#primitive-types"
				},
				{
					"match": "\\b(type)\\b",
					"name": "storage.type.anvil"
				},
				{
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=<)",
					"captures": {
						"1": {
							"name": "entity.name.type.anvil"
						}
					}
				},
				{
					"match": "[<>]",
					"name": "punctuation.definition.typeparameters.anvil"
				},
				{
					"match": "\\b[A-Z][A-Z0-9_]+\\b",
					"name": "variable.other.constant.anvil"
				},
				{
					"match": "\\b(?!left\\b|right\\b)([A-Za-z_][A-Za-z0-9_]*)\\b",
					"name": "entity.name.type.anvil"
				},
				{
					"include": "#numbers"
				}
			]
		},
		"typed-name": {
			"match": "\\b([A-Za-z_][A-Za-z0-9_]*)((?:\\[[^\\]]*\\])*)\\s*(:)(?![:=])\\s*(?:(left|right)\\s+)?(?:(logic|int|void)\\b|([A-Za-z_][A-Za-z0-9_]*))?",
			"captures": {
				"1": {
					"name": "variable.parameter.anvil"
				},
				"2": {
					"name": "meta.index.anvil"
				},
				"3": {
					"name": "keyword.operator.type.annotation.anvil"
				},
				"4": {
					"name": "storage.modifier.direction.anvil"
				},
				"5": {
					"name": "support.type.primitive.anvil"
				},
				"6": {
					"name": "entity.name.type.anvil"
				}
			}
		},
		"type-annotation": {
			"match": "(?<![+:])(:)(?![:=])\\s*(?:(left|right)\\s+)?(?:(logic|int|void)\\b|([A-Za-z_][A-Za-z0-9_]*)\\b)(?!\\s*\\()",
			"captures": {
				"1": {
					"name": "keyword.operator.type.annotation.anvil"
				},
				"2": {
					"name": "storage.modifier.direction.anvil"
				},
				"3": {
					"name": "support.type.primitive.anvil"
				},
				"4": {
					"name": "entity.name.type.anvil"
				}
			}
		},
		"type-parameters": {
			"begin": "<(?=\\s*[A-Za-z_][A-Za-z0-9_]*\\s*:)",
			"end": ">",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.typeparameters.begin.anvil"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.typeparameters.end.anvil"
				}
			},
			"patterns": [
				{
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(int|type)\\b",
					"captures": {
						"1": {
							"name": "entity.name.type.parameter.anvil"
						},
						"2": {
							"name": "keyword.operator.type.annotation.anvil"
						},
						"3": {
							"name": "storage.type.anvil"
						}
					}
				},
				{
					"include": "#comments"
				}
			]
		},
		"message-specifier": {
			"match": "\\b([A-Za-z_][A-Za-z0-9_]*)((?:\\[[^\\]]*\\])*)(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b",
			"captures": {
				"1": {
					"name": "variable.other.object.endpoint.anvil"
				},
				"2": {
					"name": "meta.index.anvil"
				},
				"3": {
					"name": "punctuation.accessor.anvil"
				},
				"4": {
					"name": "variable.other.property.message.anvil"
				}
			}
		},
		"session-type": {
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#braces-session"
				},
				{
					"match": "(?:\\b(rec)|(μ))\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\.)(?!\\()",
					"captures": {
						"1": {
							"name": "keyword.control.recursion.anvil"
						},
						"2": {
							"name": "keyword.control.recursion.anvil"
						},
						"3": {
							"name": "entity.name.type.session-variable.anvil"
						},
						"4": {
							"name": "punctuation.separator.anvil"
						}
					}
				},
				{
					"match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
					"captures": {
						"1": {
							"name": "storage.type.anvil"
						},
						"2": {
							"name": "entity.name.type.session-variable.anvil"
						},
						"3": {
							"name": "keyword.operator.assignment.anvil"
						}
					}
				},
				{
					"match": "\\bin\\b",
					"name": "keyword.control.anvil"
				},
				{
					"match": "(?:\\b(forall)|(∀))\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?:(:)|(∈))",
					"captures": {
						"1": {
							"name": "keyword.control.quantifier.anvil"
						},
						"2": {
							"name": "keyword.control.quantifier.anvil"
						},
						"3": {
							"name": "punctuation.section.parens.anvil"
						},
						"4": {
							"name": "variable.other.index.anvil"
						},
						"5": {
							"name": "keyword.operator.anvil"
						},
						"6": {
							"name": "keyword.operator.anvil"
						}
					}
				},
				{
					"match": "\\bnot\\b| ̸",
					"name": "keyword.operator.exclusion.anvil"
				},
				{
					"match": "\\bF\\b",
					"name": "keyword.other.future.anvil"
				},
				{
					"match": "(#)([A-Za-z_][A-Za-z0-9_]*)((?:\\[[^\\]]*\\])*)(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b",
					"captures": {
						"1": {
							"name": "keyword.operator.nonblocking.anvil"
						},
						"2": {
							"name": "variable.other.object.endpoint.anvil"
						},
						"3": {
							"name": "meta.index.anvil"
						},
						"4": {
							"name": "punctuation.accessor.anvil"
						},
						"5": {
							"name": "variable.other.property.message.anvil"
						}
					}
				},
				{
					"include": "#message-specifier"
				},
				{
					"include": "#delay"
				},
				{
					"match": "\\^\\^|[⨁⊕]ᶠ",
					"name": "keyword.operator.offer.fair.anvil"
				},
				{
					"match": "\\+\\+|\\+ᶠ",
					"name": "keyword.operator.composition.fair.anvil"
				},
				{
					"match": "[&^](?=\\s*\\()|[⋀∧⨁⊕]",
					"name": "keyword.operator.offer.anvil"
				},
				{
					"match": "[∑∏]|\\|\\||\\+",
					"name": "keyword.operator.composition.anvil"
				},
				{
					"match": ";",
					"name": "keyword.operator.sequence.anvil"
				},
				{
					"match": "\\.(?=\\()",
					"name": "keyword.operator.match.anvil"
				},
				{
					"match": "\\*",
					"name": "constant.language.wildcard.anvil"
				},
				{
					"match": "\\$",
					"name": "keyword.operator.terminal.anvil"
				},
				{
					"match": "\\.\\.",
					"name": "keyword.operator.range.anvil"
				},
				{
					"match": ":",
					"name": "punctuation.separator.continuation.anvil"
				},
				{
					"match": "\\b[A-Z][A-Za-z0-9_]*\\b",
					"name": "entity.name.type.session-variable.anvil"
				},
				{
					"match": "\\(\\s*\\)",
					"name": "constant.language.skip.anvil"
				},
				{
					"include": "#numbers"
				}
			]
		},
		"braces-session": {
			"begin": "\\{",
			"end": "\\}",
			"beginCaptures": {
				"0": {
					"name": "punctuation.section.braces.begin.anvil"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.section.braces.end.anvil"
				}
			},
			"patterns": [
				{
					"include": "#session-type"
				}
			]
		},
		"interface": {
			"begin": "\\b(interface)\\b\\s*(?:(<)([^>]*)(>)\\s*)?([A-Za-z_][A-Za-z0-9_]*)?",
			"beginCaptures": {
				"1": {
					"name": "storage.type.interface.anvil"
				},
				"2": {
					"name": "punctuation.definition.typeparameters.anvil"
				},
				"3": {
					"name": "meta.typeparameters.anvil"
				},
				"4": {
					"name": "punctuation.definition.typeparameters.anvil"
				},
				"5": {
					"name": "entity.name.type.interface.anvil"
				}
			},
			"end": "(?=^\\s*(?:proc|chan|type|struct|enum|func|const|import|extern|interface|pool)\\b)",
			"patterns": [
				{
					"begin": "\\(",
					"end": "\\)",
					"beginCaptures": {
						"0": {
							"name": "punctuation.section.parens.begin.anvil"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.section.parens.end.anvil"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"include": "#typed-name"
						},
						{
							"include": "#types"
						}
					]
				},
				{
					"begin": "=",
					"end": "(?=^\\s*(?:proc|chan|type|struct|enum|func|const|import|extern|interface|pool)\\b)",
					"beginCaptures": {
						"0": {
							"name": "keyword.operator.assignment.anvil"
						}
					},
					"patterns": [
						{
							"include": "#session-type"
						}
					]
				}
			]
		},
		"pool": {
			"begin": "\\b(pool)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
			"beginCaptures": {
				"1": {
					"name": "storage.type.pool.anvil"
				},
				"2": {
					"name": "entity.name.type.pool.anvil"
				},
				"3": {
					"name": "punctuation.section.braces.begin.anvil"
				}
			},
			"end": "\\}",
			"endCaptures": {
				"0": {
					"name": "punctuation.section.braces.end.anvil"
				}
			},
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)((?:\\[[^\\]]*\\])*)\\s*(--)\\s*([A-Za-z_][A-Za-z0-9_]*)((?:\\[[^\\]]*\\])*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "variable.other.object.endpoint.anvil"
						},
						"2": {
							"name": "meta.index.anvil"
						},
						"3": {
							"name": "keyword.operator.connect.anvil"
						},
						"4": {
							"name": "variable.other.object.endpoint.anvil"
						},
						"5": {
							"name": "meta.index.anvil"
						},
						"6": {
							"name": "keyword.operator.type.annotation.anvil"
						},
						"7": {
							"name": "entity.name.type.channel.anvil"
						}
					}
				},
				{
					"begin": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
					"beginCaptures": {
						"1": {
							"name": "variable.other.member.anvil"
						},
						"2": {
							"name": "keyword.operator.type.annotation.anvil"
						},
						"3": {
							"name": "entity.name.type.interface.anvil"
						},
						"4": {
							"name": "punctuation.section.parens.begin.anvil"
						}
					},
					"end": "\\)",
					"endCaptures": {
						"0": {
							"name": "punctuation.section.parens.end.anvil"
						}
					},
					"patterns": [
						{
							"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
							"name": "variable.other.object.endpoint.anvil"
						}
					]
				},
				{
					"begin": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
					"end": "(?=,\\s*{ID}\\s*:|\\}})",
					"beginCaptures": {
						"1": {
							"name": "variable.other.member.anvil"
						},
						"2": {
							"name": "keyword.operator.type.annotation.anvil"
						}
					},
					"patterns": [
						{
							"include": "#session-type"
						}
					]
				},
				{
					"include": "#types"
				}
			]
		},
		"channel-class": {
			"begin": "\\b(chan)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=[<{])",
			"beginCaptures": {
				"1": {
					"name": "storage.type.channel.anvil"
				},
				"2": {
					"name": "entity.name.type.channel.anvil"
				}
			},
			"end": "\\}",
			"endCaptures": {
				"0": {
					"name": "punctuation.section.braces.end.anvil"
				}
			},
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#type-parameters"
				},
				{
					"match": "\\{",
					"name": "punctuation.section.braces.begin.anvil"
				},
				{
					"begin": "\\b(protocol)\\s*(::)",
					"end": "(?=\\})",
					"beginCaptures": {
						"1": {
							"name": "storage.type.protocol.anvil"
						},
						"2": {
							"name": "punctuation.separator.anvil"
						}
					},
					"patterns": [
						{
							"include": "#session-type"
						}
					]
				},
				{
					"match": "\\b(left|right)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
					"captures": {
						"1": {
							"name": "storage.modifier.direction.anvil"
						},
						"2": {
							"name": "entity.name.function.message.anvil"
						},
						"3": {
							"name": "keyword.operator.type.annotation.anvil"
						}
					}
				},
				{
					"match": "(@)\\s*(dyn|eternal)\\b",
					"captures": {
						"1": {
							"name": "keyword.operator.timing.anvil"
						},
						"2": {
							"name": "constant.language.timing.anvil"
						}
					}
				},
				{
					"match": "(@)\\s*(#)([0-9]+)(~)([0-9]+)",
					"captures": {
						"1": {
							"name": "keyword.operator.timing.anvil"
						},
						"2": {
							"name": "keyword.operator.delay.anvil"
						},
						"3": {
							"name": "constant.numeric.anvil"
						},
						"4": {
							"name": "keyword.operator.anvil"
						},
						"5": {
							"name": "constant.numeric.anvil"
						}
					}
				},
				{
					"match": "(@)\\s*(#)([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "keyword.operator.timing.anvil"
						},
						"2": {
							"name": "keyword.operator.delay.anvil"
						},
						"3": {
							"name": "variable.other.property.message.anvil"
						}
					}
				},
				{
					"match": "(@)\\s*(#)([0-9]+)",
					"captures": {
						"1": {
							"name": "keyword.operator.timing.anvil"
						},
						"2": {
							"name": "keyword.operator.delay.anvil"
						},
						"3": {
							"name": "constant.numeric.cycles.anvil"
						}
					}
				},
				{
					"match": "(@)\\s*([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "keyword.operator.timing.anvil"
						},
						"2": {
							"name": "variable.other.property.message.anvil"
						}
					}
				},
				{
					"match": "<<|>>",
					"name": "keyword.operator.handshake.anvil"
				},
				{
					"match": "[+\\-]",
					"name": "keyword.operator.anvil"
				},
				{
					"match": ",",
					"name": "punctuation.separator.comma.anvil"
				},
				{
					"include": "#types"
				}
			]
		},
		"struct": {
			"begin": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"end": "\\}",
			"beginCaptures": {
				"1": {
					"name": "storage.type.struct.anvil"
				},
				"2": {
					"name": "entity.name.type.struct.anvil"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.section.braces.end.anvil"
				}
			},
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#type-parameters"
				},
				{
					"match": "\\{",
					"name": "punctuation.section.braces.begin.anvil"
				},
				{
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
					"captures": {
						"1": {
							"name": "variable.other.property.anvil"
