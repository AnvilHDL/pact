// isend asserts valid unconditionally, but a valid/ready sender must wait
// for ready first.
chan ch {
    left req : (logic[2]@#1) <<
}
proc receiver(e : left ch) {
    loop { let v = recv e.req >> dprint "got %d" (v); cycle 1 }
}
proc top() {
    chan a_le -- a_ri : ch;
    spawn receiver(a_le);
    loop { isend a_ri.req(2'd1) >> cycle 1 }
}
