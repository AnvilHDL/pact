// Pipeline components, formerly imported from pipeline/.

chan Reg_itfc<T : type> {
    left input_v : (T@#1) @#1-@dyn,
    right output : (T@#1) @#input_v+1-@#input_v+1
}

proc Reg<T : type> (endp : left Reg_itfc<T>) {
    reg r : T;
    loop {
        let r_val = recv endp.input_v >>
        set r := r_val >>
        send endp.output (*r)
    }
}

proc simple_usereg_pipeline () {
    chan le -- ri : Reg_itfc<logic>;
    spawn Reg<logic>(le);
    reg cycle_count : logic[4];

    recursive {
        {
            cycle 3 >>
            send ri.input_v(1'b1) >>
            cycle 1 >>
            let res = recv ri.output >>
            dprint "Res = %d @ %d" (res, *cycle_count)
        };
        cycle 1 >> recurse
    }

    loop {
        set cycle_count := *cycle_count + 4'd1
    }

}