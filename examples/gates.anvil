chan ch{
    left req : (logic@#1)
}
proc gates(ep : left ch){
    reg res : logic;
    reg rot : logic;
    control<^>{
        := res; :=rot
    }test2_ctrl;
    control <&>{
        ep.req; :=res
    }test_ctrl;
    loop{
        let x = recv ep.req >>
        (set res := x ;
        set rot := 1'd1)>>
        cycle 1
    }
}