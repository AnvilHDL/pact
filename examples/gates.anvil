chan ch{
    left req : (logic@#1)
}
proc gates(ep : left ch){
    reg res : logic;
    control <&>{
        ep.req; :=res
    }test_ctrl;
    loop{
        let x = recv ep.req >>
        set res := x >>

        let x = recv ep.req >>
        cycle 4 >>
        set res := 1'd1 >>
        cycle 1
    }
}