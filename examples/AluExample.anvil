// Pipeline components, formerly imported from pipeline/.

chan Reg_itfc<T : type> {
    left input_v : (T@#1) @#1-@dyn,
    right output : (T@#1) @#input_v+1-@#input_v+1
}

proc Reg<T : type> (endp : left Reg_itfc<T>) {
    reg r : T;
    loop {
        let r_val = recv endp.input_v >>
        set r := r_val >>
        send endp.output (*r)
    }
}

chan Add_itfc<T : type> {
    left input_l : (T@#1) @#1-@dyn,
    left input_r : (T@#1) @#input_l-@#input_l,
    right output : (T@#1) @#input_l-@#input_l
}

proc Add<T : type> (endp : left Add_itfc<T>) {
    loop {
        let l = recv endp.input_l >>
        let r = recv endp.input_r >>
        send endp.output (l + r) >>
        cycle 1
    }
}

chan Mux_itfc<T : type> {
    left input_l : (T@#1) @#1-@dyn,
    left input_r : (T@#1) @#input_l-@#input_l,
    left input_op : (logic@#1) @#input_l-@#input_l,
    right output : (T@#1) @#input_l-@#input_l
}

proc Mux<T : type> (endp : left Mux_itfc<T>) {
    loop {
        let l = recv endp.input_l >>
        let r = recv endp.input_r;
        let op = recv endp.input_op;
        r >> op >>
        send endp.output (if op { r } else { l } ) >>
        cycle 1
    }
}

chan SubtractDelayed_itfc<T : type> {
    left input_l : (T@#1) @#1-@dyn,
    left input_r : (T@#1) @#input_l-@#input_l,
    right output : (T@#1) @#input_l+2-@#input_l+2
}

proc SubtractDelayed<T : type> (endp : left SubtractDelayed_itfc<T>) {
    reg r0 : T;
    reg r1 : T;

    recursive {
        let l = recv endp.input_l >>
        {
            {
                let r = recv endp.input_r >>
                set r0 := l - r >>
                set r1 := *r0 >>
                send endp.output (*r1)
            };
            cycle 1 >> recurse
        }
    }
}

chan Alu_itfc<T : type> {
    left input_l : (T@#1) @#1-@dyn,
    left input_r : (T@#1) @#input_l-@#input_l,
    left input_op : (logic@#1) @#input_l+2-@#input_l+2,
    right output : (T@#1) @#input_l+2-@#input_l+2
}

proc Alu<T : type> (endp : left Alu_itfc<T>) {
    chan mux_le -- mux_ri : Mux_itfc<T>;
    chan add_le -- add_ri : Add_itfc<T>;
    chan reg0_le -- reg0_ri : Reg_itfc<T>;
    chan reg1_le -- reg1_ri : Reg_itfc<T>;
    chan sub_le -- sub_ri : SubtractDelayed_itfc<T>;
    spawn Add<T> (add_le);
    spawn Mux<T> (mux_le);
    spawn Reg<T> (reg0_le);
    spawn Reg<T> (reg1_le);
    spawn SubtractDelayed<T> (sub_le);

    recursive {
        let l = recv endp.input_l >> {
            {
                let r = recv endp.input_r >>
                let result = {
                    let add_res = (
                        send add_ri.input_l (l) >>
                        send add_ri.input_r (r) >>
                        let res_add = recv add_ri.output >>
                        send reg0_ri.input_v (res_add) >>
                        cycle 1 >>
                        let reg0_v = recv reg0_ri.output >>
                        send reg1_ri.input_v (reg0_v) >>
                        cycle 1 >>
                        recv reg1_ri.output
                    );
                    let sub_res = (
                        send sub_ri.input_l (l) >>
                        send sub_ri.input_r (r) >>
                        cycle 2 >> recv sub_ri.output
                    );
                    add_res >> sub_res >>
                    let op = recv endp.input_op >>
                    send mux_ri.input_l (add_res) >>
                    send mux_ri.input_r (sub_res) >>
                    send mux_ri.input_op (op) >>
                    recv mux_ri.output
                } >>
                send endp.output (result)
            };
            cycle 1 >> recurse
        }
    }
}

proc AluExample () {
    chan alu_le -- alu_ri : Alu_itfc<logic[4]>;
    spawn Alu<logic[4]>(alu_le);

    reg clock_counter : logic[8];

    recursive {
        {
            send alu_ri.input_l (*clock_counter[0+:4]) >>
            send alu_ri.input_r (*clock_counter[4+:4]) >>
            cycle 2 >>
            send alu_ri.input_op (*clock_counter[3]) >>
            let res = recv alu_ri.output >>
            dprint "Result = %d @ %d" (res, *clock_counter)
        };
        cycle 1 >> recurse
    }

    loop {
        set clock_counter := *clock_counter + 8'd1
    }
}
