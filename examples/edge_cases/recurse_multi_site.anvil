// A recursive thread may restart from more than one recurse. Every recurse
// must restart the thread; previously only one did, so the thread stopped
// for good after taking the other path.
proc recurse_multi_site() {
    reg c : logic[4];
    recursive {
        set c := *c + 4'd1 >>
        if (*c == 4'd3) {
            dprint "short %d" (*c) >> cycle 1 >> recurse
        } else {
            dprint "long %d" (*c) >> cycle 2 >> recurse
        }
    }
    loop {
        cycle 30 >> dfinish
    }
}
