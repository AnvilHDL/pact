
chan cache_ch {
    left rd_req : (logic[16]@hit+1), //--> (hit || miss),
    right hit : (logic[8]@#1),
    right miss : (logic[8]@#1)
}


chan mem_ch{
    left req : (logic[16]@#1), //--> resp
    right resp : (logic[8]@#1)
}

proc test_gate_cache(ep : left cache_ch, mem_ep : right mem_ch){
    reg mem : logic[32][8];
    reg tag : logic[32][11];
    control<&> when <mem_ep.resp>{
        := tag ; :=mem
    }miss_control;//implies AG (mem_ep.resp -> AF (RegMut(tag) and RegMut(mem)))

    loop{
        let x = recv ep.rd_req >>
        let addr = x[0+:5] >>
        let tag = x[5+:11] >>
        if(*tag[addr] == tag){
            send ep.hit(*mem[addr])
        } else {
            send mem_ep.req(x);
            let y = recv mem_ep.resp >>
            (set mem[addr] := y >>
            set tag[addr] := x[5+:11]) >>
            send ep.miss(*mem[addr])
        } >>
        cycle 1
    }
}