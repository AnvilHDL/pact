opam-version: "2.0"
version: "0.1.0"
synopsis: "An HDL that helps avoid mistakes"
description:
  "Pact is an extension of anvil with a type system for communication safe hardware design."
maintainer: ["Team Anvil"]
authors: ["Team Anvil"]
license: "MIT"
tags: ["hdl" "safety" "fpga"]
homepage: "https://github.com/arj4web/pact"
bug-reports: "https://github.com/arj4web/pact/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.20" & >= "3.8"}
  "menhir" {>= "20180523"}
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
