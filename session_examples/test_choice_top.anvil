chan local_ch{
    left req : (logic@#1),
    right ack : (logic@#1),
    right reset : (logic@#1)
    protocol :: (ep.req >> ep.ack)
}


interface test_choice (ep : left local_ch) = (ep.req >> F (ep.ack + ep.reset) >> #1);

interface test_dual_choice (ep : right local_ch) = (ep.req >> F (ep.ack + ep.reset));

proc test_choice(test_choice){
    loop{
        let r = recv ep.req  >> 
        cycle 2 >>
        cycle 1 >>
        if (1'd1){
            send ep.ack(1'd1) >>
            dprint "Sent ack" (1'd0)
        } else {
            send ep.ack(1'd0) >>
            dprint "Sent reset" (1'd0)
        } >>
        cycle 1

    }

}

proc test_choice_top()
{
    chan ep_le -- ep_ri : local_ch;
    spawn test_choice(ep_le);
    loop{
        cycle 100 >> 
        dfinish
    }
    loop{
        send ep_ri.req(1'd1) >>
        let r = recv ep_ri.ack >>
        cycle 1
    }
}