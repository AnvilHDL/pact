
interface slave_itfc(r_req_ep :left arbiter_slave_ch<T1> , slv_r_ep : left slv_r_ch<r_pack_t> ) =
         r_req_ep.req ; r_req_ep.gnt ; slv_r_ep.res; ^(slv_r_ep.data, slv_r_ep.err) ; #1 

interface rr_arbiter_itfc(slv_ep1 : right arbiter_slave_ch<T>, slv_ep2 : right arbiter_slave_ch<T>, mst_ep : left req_inp_ch<ar_sel_pack_t>) =

^( 
   slv_ep1.req : mst_ep.req ; slv_ep1.gnt,
   slv_ep2.req : mst_ep.req ; slv_ep2.gnt
) ; #1

interface fifo_itfc(ep : left fifo_ch<data_t>) =  ((ep.full ; ep.pop;#1;&(ep.push,ep.pop,*)) + (ep.empty ; ep.push;#1;&(ep.push,ep.pop,*)) + &(ep.push, ep.pop)) ; #1

interface master_itfc(mst_req_ep : right ar_mast_ch,  mst_res_ep : left req_inp_ch<r_pack_t>) = mst_req_ep.rdy ; mst_req_ep.data ; mst_res_ep.req ; #1 


interface spill_register_itfc(inp_ep : right req_inp_ch<T>, out_ep : left reg_out_ch<T>) = ((inp_ep.req;#1;&(inp_ep.req, out_ep.spill,*)) +  (&(inp_ep.req, out_ep.spill, *)) + (out_ep.spill;#1;&(inp_ep.req,out_ep.spill,*)));#1


interface mux_ar_main (
    ar_req_ep : right reg_out_ch<ar_sel_pack_t>,
    mst_req_ep : left ar_mast_ch <ar_pack_t>,
    fifo_ep : right fifo_ch<select_t>
) =^(
        fifo_ep.empty : mst_req_ep.rdy ; ar_req_ep.spill ; mst_req_ep.data ; #fifo_ep.push,
        * : mst_req_ep.rdy;ar_req_ep.spill ; mst_req_ep.data ; #fifo_ep.push
    ) ; #1 
interface mux_r_main (
    r_sr_ep : right reg_out_ch <r_pack_t>,
    fifo_ep : right fifo_ch<select_t>,
    slv_ep1 : right slv_r_ch<r_pack_t>,
    slv_ep2 : right slv_r_ch<r_pack_t>
) =^(
        fifo_ep.full : r_sr_ep.spill ; #fifo_ep.pop ; (^(slv_ep1.res : slv_ep1.err + slv_ep1.data , slv_ep2.res : slv_ep2.err + slv_ep2.data )),
        * : r_sr_ep.spill ; #fifo_ep.pop ; ^(slv_ep1.res : (slv_ep1.err + slv_ep1.data) , slv_ep2.res : (slv_ep2.err + slv_ep2.data) )
); #1

pool arbiter_slave_pool {
    slv_ep1 -- arb_ep1 : arbiter_slave_ch<ar_pack_t>,
    slv_ep2 -- arb_ep2 : arbiter_slave_ch<ar_pack_t>,
    slv_ep_r_1 -- mux_ep_r_1 : slv_r_ch<r_pack_t>,
    slv_ep_r_2 -- mux_ep_r_2 : slv_r_ch<r_pack_t>,

    arb_reg_ep -- reg_arb_ep : req_inp_ch<ar_sel_pack_t>,
    reg_mst_ep -- mux_reg_ep : reg_out_ch<ar_sel_pack_t>,

    mst_ep_reg -- reg_ep_r : req_inp_ch<r_pack_t>,
    reg_ep_slv -- mux_ep_r : reg_out_ch<r_pack_t>,

    mux_ep_mst -- mst_ep_mux : ar_mast_ch,

    fifo_ep_le -- fifo_ep_ri : fifo_ch<select_t>;
    
    i1 : slave_itfc(slv_ep1 , slv_ep_r_1),
    i2 : slave_itfc(slv_ep2 , slv_ep_r_2),
    i3 : rr_arbiter_itfc(arb_ep1,arb_ep2, arb_reg_ep),
    i4 : spill_register_itfc(reg_arb_ep, reg_mst_ep),
    i51 : mux_ar_main(mux_reg_ep, mux_ep_mst, fifo_ep_ri),
    i52 : mux_r_main(mux_ep_r,  fifo_ep_ri, mux_ep_r_1, mux_ep_r_2),
    i6 : fifo_itfc(fifo_ep_le),
    i7 : spill_register_itfc(reg_ep_r, reg_ep_slv),
    i8 : master_itfc(mst_ep_mux, mst_ep_reg)
}