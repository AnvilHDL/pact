
interface slave_itfc(r_req_ep :left arbiter_slave_ch<T1> , slv_r_ep : left slv_r_ch<r_pack_t> ) =
         r_req_ep.req ; r_req_ep.gnt ; slv_r_ep.res; ^(slv_r_ep.data, slv_r_ep.err) ; #1 

interface rr_arbiter_itfc(slv_ep1 : right arbiter_slave_ch<T>, slv_ep2 : right arbiter_slave_ch<T>, slv_ep3 : right arbiter_slave_ch<T>, slv_ep4 : right arbiter_slave_ch<T>, slv_ep5 : right arbiter_slave_ch<T>, slv_ep6 : right arbiter_slave_ch<T>, slv_ep7 : right arbiter_slave_ch<T>, slv_ep8 : right arbiter_slave_ch<T>, mst_ep : left req_inp_ch<ar_sel_pack_t>) =

^( 
   slv_ep1.req : mst_ep.req ; #slv_ep1.gnt,
   slv_ep2.req : mst_ep.req ; #slv_ep2.gnt
//    slv_ep3.req : mst_ep.req ; #slv_ep3.gnt,
//    slv_ep4.req : mst_ep.req ; #slv_ep4.gnt,
//    slv_ep5.req : mst_ep.req ; #slv_ep5.gnt,
//    slv_ep6.req : mst_ep.req ; #slv_ep6.gnt,
//    slv_ep7.req : mst_ep.req ; #slv_ep7.gnt,
//    slv_ep8.req : mst_ep.req ; #slv_ep8.gnt
) ; #1

interface fifo_itfc(ep : left fifo_ch<data_t>) =  ((ep.full ; ep.pop;#1) + (ep.empty ; ep.push;#1) + &(ep.push, ep.pop)) ; #1

interface master_itfc(mst_req_ep : right ar_mast_ch,  mst_res_ep : left req_inp_ch<r_pack_t>) = #4 ; mst_req_ep.rdy ; mst_req_ep.data ; mst_res_ep.req ; #1 


interface spill_register_itfc(inp_ep : right req_inp_ch<T>, out_ep : left reg_out_ch<T>) = (inp_ep.req ; #1) +  (&(inp_ep.req: #1, out_ep.spill: #1, *:#1)) + (out_ep.spill ; #1)

