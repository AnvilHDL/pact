chan ch {
    left req : (logic@#1),
    left ack : (logic@#1)
}

interface trywild_interface (ep : left ch) = &(#ep.req : #5, #ep.ack : #3, * : #5) 
proc tryand(trywild_interface){
    reg cyc : logic[8];
    loop{
       offer{
            x= irecv ep.req => (
                dprint "[Cycle %d] try received req: %d" (*cyc, x) >>
                cycle 5
            ),
            x = irecv ep.ack => (
                dprint "[Cycle %d] try received ack: %d" (*cyc, x)
                >>
                cycle 3
            )
       } else {
            dprint "[Cycle %d] Nothing recieved in wildcard arm" (*cyc) >>
            cycle 5
       }

    }
    loop{
        set cyc := *cyc + 8'd1
    }
}


interface wildcard_top_interface(pe : right ch) = #4 ; pe.req ; pe.ack ;#1 

pool wildcard_pool{
    ep_le -- ep_ri : ch;
    i1 : trywild_interface(ep_le),
    i2 : wildcard_top_interface(ep_ri)
}

proc test_wildcard_top(){
    pool p : wildcard_pool;
    spawn tryand[p.i1];
    reg cyc : logic[8];
    loop{

        cycle 4 >>
        send ep_ri.req(1'd1) >>
        dprint "[Cycle %d] Top sent req" (*cyc) >>
        send ep_ri.ack(1'd1) >>
        dprint "[Cycle %d] Top sent ack" (*cyc) >>
        cycle 1
    }
    loop{
        cycle 100 >> 
        dfinish
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}