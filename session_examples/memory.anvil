type byte = logic[8];
struct addr_data_pair {
    addr : byte,
    data : byte
}
chan read_ch{
    right req : (byte@#1),
    left res : (byte@#1)
}
chan write_ch{
    left req : (addr_data_pair@#1),
    right res : (addr_data_pair@#1)
}

interface mem_itfc (rd_ep : right read_ch, wr_ep : left write_ch) = ⋀(rd_ep.req : F #rd_ep.res, wr_ep.req) ; #1
proc memory(mem_itfc){
    reg mem : byte[256];
    reg rd_data : byte;
    loop {
        offer {
            addr = recv rd_ep.req => (
                       set rd_data := *mem[addr] >>
                       isend rd_ep.res(*rd_data) >>
                       cycle 1
                    ),
            inp =  recv wr_ep.req => set mem[inp.addr] := inp.data
        }
    }
}