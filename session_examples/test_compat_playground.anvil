pool p1 { // trued
    ep_le -- ep_ri : ch;
    ip11 : (ep.req ; ep.ack) ,
    ip12 : (ep.req ; ep.ack)
}

pool p2 { // true
    ep_le -- ep_ri : ch;
    ip21 : (#ep.req ; #ep.ack) ,
    ip22 : (#ep.req || #ep.ack)
}

pool p3 { // true
    ep_le -- ep_ri : ch;
    ip31 : #ep.req  + #ep.ack ,
    ip32 : ^( #ep.req , #ep.ack) 
}
pool p4 { // true
    ep_le -- ep_ri : ch;
    ip41 : #ep.req  + #ep.ack ,
    ip42 : &(#ep.req , #ep.ack) 
}

pool p5 { // true
    ep_le -- ep_ri : ch;
    ip51 : ep.m1 ,
    ip52 : #2;ep.m1
}

pool p6 { // true
    ep_le -- ep_ri : ch;
    ip61 : F ep.m1 ,
    ip62 : ep.m1
}

pool p7 { // true
    ep_le -- ep_ri : ch;
    ip71 : ep.m1,
    ip72 : ep.m1;ep.m1
}
pool p8 { // false
    ep_le -- ep_ri : ch;
    ip81 : #ep.m1 + #ep.m2 ,
    ip82 : ^( #ep.m1, * : #ep.m2 ) 
}
pool p9 { // true
    ep_le -- ep_ri : ch;
    ip91 : ep.m1 ,
    ip92 : rec X . ^( #ep.m1 , * : X ) 
}

pool p10 { // true
    ep_le -- ep_ri : ch;
    ip101 : #ep.m1 || #ep.m2 ,
    ip102 : #ep.m1,
    ip103 : #ep.m2
}

pool p11 { // true
    ep_le -- ep_ri : ch;
    ip111 : rec X . ^( #ep.m1 , * : #1 ; X ) ,
    ip112 : F #ep.m1 
}

pool p12 { // false
    ep_le -- ep_ri : ch;
    in121 : (ep.m1;ep.m2) + (ep.m2;ep.m1),
    in122 : ep.m1,
    in123 : ep.m2
}
pool p13 {
    ep_le -- ep_ri : ch;
    ip131 : ep.req;#4,
    ip132 : ep.req;#1
}
pool p14 {
    ep_le -- ep_ri : ch;
    ip141 : #ep.req || #ep.ack,
    ip142 : #ep.req ; #ep.ack
}
pool p15 { // false
    ep_le -- ep_ri : ch;
    in151 : ep.m1;&(ep.m2,ep.m3),
    in152 : ep.m1,
    in153 : ^(ep.m2,*),
    in154 : ^(ep.m3,*)
}

pool p16{
    ep_le -- ep_ri : ch;
    ip161 : ep.m1;^(ep.m2,ep.m3);#1,
    ip162 : ^(ep.m1,*);#2,
    ip163 : ^(ep.m2,*);#3,
    ip164 : ^(ep.m3,*);#4

}

pool p17 { // true
    ep_le -- ep_ri : ch;
    ip171 : &(ep.m1,ep.m2),
    ip172 : ep.m1
}
pool p18 { // false
    ep_le -- ep_ri : ch;
    in101 : ^(#ep.m1, #ep.m2) ,
    in182 : #ep.m1;#ep.m2
}
pool p19 { // true
    ep_le -- ep_ri : ch;
    ip191 : &(ep.m1, ep.m2,*);#1,
    ip192 : #2;ep.m1
}
pool p20{
    ep_le -- ep_ri : ch;
    in201 : ^(#ep.m1, #ep.m2),
    in202 : ^(#ep.m1, * ) || ^( #ep.m2, * )
} 
pool p21 {
    ep_le -- ep_ri : ch;
    in211 : (ep1.m1 + ep2.m2);#1,
    in212 : ep1.m1;#1,
    in213 : ep2.m2;#1
}
// Negative cases
pool n1 { // false
    ep_le -- ep_ri : ch;
    in11 : #ep.req + #ep.ack ,
    in12 : #ep.req || #ep.ack 
}

pool n2 { // false
    ep_le -- ep_ri : ch;
    in21 : #ep.req  + #ep.ack ,
    in22 : #ep.req  + #ep.ack
}

pool n3 { // false
    ep_le -- ep_ri : ch;
    in31 : ep.m1 ; ^(#ep.m2, *),
    in3 : #ep.m1 + #ep.m2 
}

pool n4 { // false
    ep_le -- ep_ri : ch;
    in41 : F #ep.m1 ,
    in42 : #ep.m1 
}

pool n5 { // true
    ep_le -- ep_ri : ch;
    p1 : () + &(#ep.m1, #ep.m2),
    p2 :#ep.m1 ,
    p3 : #ep.m4; #ep.m2,
    p4 : #ep.m4

}
    
pool n6 { // false
    ep_le -- ep_ri : ch;
    in61 : &(ep.m1, ep.m2) ,
    in62 : ep.m1
}

pool n7 { // false
    ep_le -- ep_ri : ch;
    in71 : (#ep.m1+#ep.m2);#1,
    in72 : #ep.m1;#1,
    in73 : #ep.m2;#1
}

pool n8 { // false
    ep_le -- ep_ri : ch;
    in81 : ^(#ep.m1 : #ep.m3, #ep.m2 : #ep.m4) ,
    in82 : #ep.m1;#ep.m3,
    in83 : #ep.m2
}
