chan ch{
    left req : (logic@#1) >> ,
    right res : (logic@#1) <<
}
proc foo(ep : left ch){
    reg response : logic;
    loop{
        cycle 10 >>
        let x = recv ep.req >>
        dprint "[foo]Received: %d\n"  (x) >>
        set response := x + 1'd1 >>
        cycle 9 >>
        dprint "[foo]Sending response: %d\n" (*response) >>
        send ep.res(*response) >>
        cycle 1
    }
}


proc test_readyack_top(){
    chan  ep_le -- ep_ri : ch;
    spawn foo(ep_le);
    loop{
        send ep_ri.req(1'd1) >>
        dprint "[top]Sent request\n" () >>
        let y = recv ep_ri.res >>
        dprint "[top]Received response: %d\n" (y) >>
        cycle 1 >>
        dfinish >>
        cycle 1
    }
}