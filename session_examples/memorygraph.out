digraph SessionTypes {
  // Graph styling
  rankdir=TB;
  bgcolor="white";
  node [shape=box, style="rounded,filled", fillcolor="lightblue", fontname="Helvetica"];
  edge [fontsize=11, fontname="Helvetica"];
  rank=max;
  
  // Node definitions with types
  event0 [
    label="event0\n( rd_ep.req : F( #rd_ep.res ) & wr_ep.req ) >> #1",
    fillcolor="lightgreen",
    tooltip="Initial state with type T"
  ];
  
  event1 [
    label="event1\n( (rd_ep.req >> F( #rd_ep.res )) + wr_ep.req ) >> #1",
    fillcolor="lightyellow",
    tooltip="Intermediate state with type T"
  ];
  
  event2 [
    label="event2\nF( #rd_ep.res ) >> #1",
    fillcolor="lightyellow",
    tooltip="Intermediate state with type T"
  ];
  
  event4 [
    label="event4\nF( #rd_ep.res ) >> #1",
    fillcolor="lightyellow",
    tooltip="Intermediate state with type T"
  ];
  
  event5 [
    label="event5\n#1",
    fillcolor="lightyellow",
    tooltip="Intermediate state with type T"
  ];

  invisible_event [
    label="",
    shape="point",
    width=0.1,
    style="invis"
  ];
  
  event6 [
    label="event6\n$ + T",
    fillcolor="lightpink",
    tooltip="Potentially terminal state with type $"
  ];
  
  event7 [
    label="event7\n#1",
    fillcolor="lightyellow",
    tooltip="Intermediate state with type T"
  ];
  
  event8 [
    label="event8\n$ + T",
    fillcolor="lightpink",
    tooltip="Potentially terminal state with type $"
  ];
  
  event9 [
    label="event9\n$",
    fillcolor="darkred",
    fontcolor="white",
    peripheries=2,
    tooltip="Terminal state"
  ];
  
  // Edge definitions grouped by source
  
  // Initial transition
  event0 -> event1 [
    label=" WRITE REQ || READ REQ",
    color="blue",
    penwidth=2
  ];
  
  // Main branching from event1 (offer construct)
  event1 -> event2 [
    label="READ REQ",
    color="gray"
  ];
  
  event1 -> event7 [
    label="WRITE REQ",
    color="gray"
  ];
  
  event1 -> event8 [
    label="NO WRITE REQ",
    color="gray"
  ];
  
  event1 -> event6 [
    label="NO READ REQ",
    color="gray"
  ];
  
  // Read request path (recv rd_ep.req branch)
  event2 -> event4 [
    label="#1",
    style="dashed",
    color="blue"
  ];
  
  event4 -> event5 [
    label="READ RES",
    tooltip="Send response",
    color="blue"
  ];
  
  event5 -> event6 [
    label="#1",
    style="dashed",
    color="blue"
  ];

  event5->invisible_event [
    style="invis"
  ];
  
  event6 -> event9 [
    label="Later",
    color="purple"
  ];
  
  // Write request path (recv wr_ep.req branch)
  event7 -> event8 [
    label="#1",
    style="dashed",
    color="blue"
  ];
  
  event8 -> event9 [
    label="Later",
    color="purple"
  ];
  
  // Legend subgraph
  subgraph cluster_legend {
    label=< <B>Legend</B> >;
    labeljust="l";
    fontsize=14;
    style="rounded,filled";
    fillcolor="white";
    color="black";
    rank=same invisible_event;
    
    // Create invisible nodes for legend items
    node [shape=plaintext, fillcolor="white", fontsize=12];
    
    legend_title [label=<
      <table border="0" cellborder="0" cellspacing="4">
        <tr><td align="left"><b>Node Types:</b></td></tr>
        <tr><td align="left" bgcolor="lightgreen">  Initial state (type T)</td></tr>
        <tr><td align="left" bgcolor="lightyellow">  Intermediate state (type T)</td></tr>
        <tr><td align="left" bgcolor="lightpink">  Potentially terminal (type $)</td></tr>
        <tr><td align="left" bgcolor="darkred"><font color="white">  Terminal state</font></td></tr>
        <tr><td align="left"> </td></tr>
        <tr><td align="left"><b>Edge Types:</b></td></tr>
        <tr><td align="left"><font color="blue">━━━</font>  Solid: Message actions</td></tr>
        <tr><td align="left"><font color="blue">╌╌╌</font>  Dashed: Static delay</td></tr>
        <tr><td align="left"><font color="gray">━━━</font>  Gray: Zero delay</td></tr>
        <tr><td align="left"><font color="purple">━━━</font>  Purple: Later continuation</td></tr>
      </table>
    >];
  }
}