chan ch{
    left req : (logic@#1),
    right ack : (logic@#1)
}


interface foo1_intfc (ep12 : left ch, ep13 : right ch) =  ep12.req ; #1 ; ep13.req ; ep13.ack ; #1 ; ep12.ack ; #1
interface foo2_intfc (ep12 : right ch, ep23 : left ch) =  ep12.req ; ep23.req ; ep23.ack ; ep12.ack ; #1
interface foo3_intfc (ep13 : left ch, ep23 :right ch)  = ep13.req ; ep23.req ; ep23.ack ; ep13.ack ; #1





proc foo1 (foo1_intfc){
    reg cyc : logic[8];
    reg relayed : logic;
    loop{
        let req_from_2 = recv ep12.req >>
        dprint "[Cycle %d] [foo1] Relaying req: %d\n" (*cyc, req_from_2) >>
        set relayed := req_from_2 >>
        send ep13.req(*relayed) >>
        let ack_from_3 = recv ep13.ack >>
        dprint "[Cycle %d] [foo1] Relaying ack: %d\n" (*cyc, ack_from_3) >>
        set relayed := ack_from_3 >>
        send ep12.ack(*relayed) >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc foo2 (foo2_intfc){
    reg cyc : logic[8];
    loop{
        send ep12.req(1'd1) >>
        let req_from_3 = recv ep23.req >>
        dprint "[Cycle %d] [foo2] Received req: %d\n" (*cyc, req_from_3) >>
        send ep23.ack(1'd1) >>
        let ack_from_1 = recv ep12.ack >>
        dprint "[Cycle %d] [foo2] Received ack: %d\n" (*cyc, ack_from_1) >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}

proc foo3 (foo3_intfc){
    reg cyc : logic[8];
    loop{
        let req_from_1 = recv ep13.req >>
        dprint "[Cycle %d] [foo3] Received req: %d\n" (*cyc, req_from_1) >>
        send ep23.req(1'd1) >>
        let ack_from_2 = recv ep23.ack >>
        dprint "[Cycle %d] [foo3] Received ack: %d\n" (*cyc, ack_from_2) >>
        send ep13.ack(1'd1) >>
        cycle 1
    }
    loop{
        set cyc := *cyc + 8'd1
    }
}


pool base_multiparty_pool {
    ep_12_le -- ep_12_ri : ch,
    ep_13_le -- ep_13_ri : ch,
    ep_23_le -- ep_23_ri : ch;
    i1 : foo1_intfc(ep_12_le, ep_13_ri),
    i2 : foo2_intfc(ep_12_ri, ep_23_le),
    i3 : foo3_intfc(ep_13_le, ep_23_ri)
}

proc test_base_multiparty(){
    pool p : base_multiparty_pool;
    spawn foo1[p.i1];
    spawn foo2[p.i2];
    spawn foo3[p.i3];

    loop{
        cycle 100 >>
        dfinish
    }
}
    
