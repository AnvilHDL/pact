interface a (ep : left ch) = ep.req + ep.res ;
interface b (ep : right ch) = ep.req || ep.res ;
interface c (ep : left ch) = &(ep.req: ep.res, ep.res:ep.req) ;


chan ch{
    left req : (logic@#1),
    right ack : (logic@#1)
}
pool p1 {
    ep_le -- ep_ri : ch;
    i1 : (ep.req >> ep.ack) ;
    i2 : (ep.req || ep.ack)
}

pool p2 {
    ep_le -- ep_ri : ch;
    i1 : (ep.req + ep.ack) ;
    i2 : &(ep.req , ep.ack)
}

pool p3{
    ep_le -- ep_ri : ch;
    i1 : (ep.req + ep.ack) >> (ep.ack + ep.req);
    i2 : &(ep.req : ep.ack, ep.ack : ep.req)
}

pool p4{
    ep_le -- ep_ri : ch;
    i1 : ep.req + ep.ack;
    i2 : ep.req
}

pool p5{
    ep_1_le -- ep_1_ri : ch,
    ep_2_le -- ep_2_ri : ch;
    i1 : ep_1.req;
    i2 : ep_1.req + ep_2.req;
    i3 : ep_2.req
}

pool p6{
    ep_1_le -- ep_1_ri : ch,
    ep_2_le -- ep_2_ri : ch,
    ep_3_le -- ep_3_ri : ch;
    i1 : ep_1.req >> ep_1.ack;
    i2 : ep_1.req >> ep_2.req >> ep_1.ack;
    i3 : ep_2.req + ep_3.req;
    i4 : ep_3.req
}

pool mem_pool{
    rd_ep_le -- rd_ep_ri : rd_ch,
    wr_ep_le -- wr_ep_ri : wr_ch;
    i1 : #1 + (rd_ep_le.req >> rd_ep_le.res >> #1);
    i2 : &(rd_ep_le.req : F #rd_ep_le.res, wr_ep_ri.req) >> #1;
    i3 : wr_ep_ri.req >> #1
}

pool p7{
    ep_le -- ep_ri : ch;
    i1 : ep.req || ep.res;
    i2 : ep.req >> ep.res
}

interface mux_main (
    ar_req_ep : right reg_out_ch<ar_sel_pack_t>,
    mst_req_ep : left ar_mast_ch <ar_pack_t>,
    r_sr_ep : right reg_out_ch <r_pack_t>,
    fifo_ep : right fifo_ch<select_t>,
    slv_ep1 : right slv_r_ch<r_pack_t>,
    slv_ep2 : right slv_r_ch<r_pack_t>,
    slv_ep3 : right slv_r_ch<r_pack_t>,
    slv_ep4 : right slv_r_ch<r_pack_t>,
    slv_ep5 : right slv_r_ch<r_pack_t>,
    slv_ep6 : right slv_r_ch<r_pack_t>,
    slv_ep7 : right slv_r_ch<r_pack_t>,
    slv_ep8 : right slv_r_ch<r_pack_t>
) =^(
        fifo_ep.full : r_sr_ep.spill >> #fifo_ep.pop >> (slv_ep1.res + slv_ep2.res + slv_ep3.res + slv_ep4.res + slv_ep5.res + slv_ep6.res + slv_ep7.res + slv_ep8.res),
        fifo_ep.empty : mst_req_ep.rdy >> ar_req_ep.spill >> mst_req_ep.data >> #fifo_ep.push,
        * : & (mst_req_ep.rdy : ar_req_ep.spill >> mst_req_ep.data >> #fifo_ep.push, r_sr_ep.spill : fifo_ep.pop >> (slv_ep1.res + slv_ep2.res + slv_ep3.res + slv_ep4.res + slv_ep5.res + slv_ep6.res + slv_ep7.res + slv_ep8.res))
    ) >> #1 ;