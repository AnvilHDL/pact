interface a (ep : left ch) = ep.req + ep.res ;
interface b (ep : right ch) = ep.req || ep.res ;
interface c (ep : left ch) = &(ep.req: ep.res, ep.res:ep.req) ;

chan ch{
    left req : (logic@#1),
    right ack : (logic@#1)
}
pool p1 {
    ep_le -- ep_ri : ch;
    i1 : (ep.req >> ep.ack) ;
    i2 : (ep.req || ep.ack)
}

pool p2 {
    ep_le -- ep_ri : ch;
    i1 : (ep.req + ep.ack) ;
    i2 : &(ep.req , ep.ack)
}

pool p3{
    ep_le -- ep_ri : ch;
    i1 : (ep.req + ep.ack) >> (ep.ack + ep.req);
    i2 : &(ep.req : ep.ack, ep.ack : ep.req)
}

pool p4{
    ep_le -- ep_ri : ch;
    i1 : ep.req + ep.ack;
    i2 : ep.req
}

pool p5{
    ep_1_le -- ep_1_ri : ch,
    ep_2_le -- ep_2_ri : ch;
    i1 : ep_1.req;
    i2 : ep_1.req + ep_2.req;
    i3 : ep_2.req
}