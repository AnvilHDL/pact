interface main (ep : left ch) = ∀ (i ∈ [1 .. 3] ̸ (1,2,3)) {ep[i].req}

interface main (ep : left ch) = ∀ (i ∈ [1 .. 3] ̸ (1,2 ,3)) {∑(ep.req,ep.req)}

interface main (ep : left ch) = ∀ (i ∈ [1 .. 3] ̸ (1,2 ,3)) {∏(ep.req,ep.req)}
interface main (ep : left ch) = ∀ (i ∈ [1 .. 3] ̸ (1,2 ,3)) {∧(ep.req,ep.req)}
interface main (ep : left ch) = ∀ (i ∈ [1 .. 3] ̸ (1,2 ,3)) {⊕(ep.req,ep.req)}