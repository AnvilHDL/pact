interface i1 (ep : left ch) = ∀_∏ (i ∈ [1..3]) { ep[i].req; #1 }

interface i2 (ep : left ch) = ∀_∏ (i ∈ [1..3]) { ep[i].ack; #2 }

interface i3 (ep : left ch) = ∀_∑ (i ∈ [1..2]) { ep[i].req; #1 }

interface i4 (ep : left ch) = ∀_∏ (i ∈ [1..5] ̸ (2,4)) { ep[i].data; #1 }

interface i5 (ep : left ch) = ∀_∏ (i ∈ [1..2]) { ∀_∏ (j ∈ [1..2]) { ep[i][j].msg; #1 } }

interface parallelRequests (ep : left ch) = ∀_∏ (i ∈ [1..3]) {  ep[i][j].req; #1 }

interface choiceRequests (ep : left ch) = ∀_∑ (i ∈ [1..3]) { ep[i].option; #1 }
