pool p16{
    ep_le -- ep_ri : ch;
    ip161 : ep.m1;^(ep.m2,ep.m3);#1,
    ip162 : ^(ep.m1,*);#2,
    ip163 : ^(ep.m2,*);#3,
    ip164 : ^(ep.m3,*);#4

}