
chan ch{
    left m1 : (logic@#1),
    left m2 : (logic@#1)
}


proc foo(ep : left ch){
    loop{
        xoffer{
            x = irecv ep.m1 =>{
                dprint "Received on m1: %d" (x)
            },
            y = irecv ep.m2 =>{
                dprint "Received on m2: %d" (y)
            }
        } 
        else{
            dprint "No messages available" ()
        } >>
        cycle 1 
    }
}